---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import videosData from '../../data/videos.json';

interface Video {
  id: string;
  slug: string;
  title: string;
  url: string;
  thumbnail: string;
  thumbnailHQ?: string;
  published?: string | null;
  author?: string | null;
  description?: string;
  playlistSlug?: string;
  playlistTitle?: string;
  position?: number;
}

interface Playlist {
  id: string;
  slug: string;
  title: string;
  url: string;
  order?: string;
  videos?: Video[];
}

interface VideoData {
  playlistUrl?: string;
  playlists?: Playlist[];
  videos?: Video[];
}

// Every video gets one page, but it is navigated as part of ONE playlist — the
// one that claimed it in the data file. Prev/next therefore walk that
// playlist's own order (episode 3 → episode 4), never the global newest-first
// list, which would jump the reader between two unrelated series.
export async function getStaticPaths() {
  const data = (await import('../../data/videos.json')).default as VideoData;
  const playlists: Playlist[] = data.playlists?.length
    ? data.playlists
    : [{ id: '', slug: 'tutorials', title: 'Video tutorials', url: data.playlistUrl ?? '', videos: data.videos ?? [] }];

  const paths: {
    params: { slug: string };
    props: {
      video: Video;
      playlist: Playlist;
      prev: Video | null;
      next: Video | null;
      total: number;
      position: number;
    };
  }[] = [];
  const seen = new Set<string>();

  for (const playlist of playlists) {
    const videos = playlist.videos ?? [];
    videos.forEach((video, i) => {
      // A video in two playlists still renders once, under the first.
      if (seen.has(video.slug)) return;
      seen.add(video.slug);

      paths.push({
        params: { slug: video.slug },
        props: {
          video,
          playlist,
          prev: i > 0 ? videos[i - 1] : null,
          next: i < videos.length - 1 ? videos[i + 1] : null,
          total: videos.length,
          position: i + 1,
        },
      });
    });
  }

  return paths;
}

const { video, playlist, prev, next, total, position } = Astro.props as {
  video: Video;
  playlist: Playlist;
  prev: Video | null;
  next: Video | null;
  total: number;
  position: number;
};

const data = videosData as VideoData;
const playlistUrl = playlist?.url ?? data.playlistUrl;

// A numbered series counts up ("Episode 3 of 6"); a reference library does not
// imply an order, so it just names the collection.
const isSeries = playlist?.order === 'playlist';
const eyebrow = isSeries
  ? `${playlist.title} · Episode ${position} of ${total}`
  : `${playlist?.title ?? 'Video tutorial'} · ${position} of ${total}`;

const publishedDate = video.published
  ? new Date(video.published).toLocaleDateString(undefined, {
      year: 'numeric', month: 'long', day: 'numeric',
    })
  : null;
---

<StarlightPage
  frontmatter={{
    title: video.title,
    description: video.description?.slice(0, 160) || `Video tutorial: ${video.title}`,
    template: 'doc',
    lastUpdated: video.published ? new Date(video.published) : undefined,
    pagefind: true,
  }}
>
  <div class="video-page-header">
    <p class="video-page-eyebrow">{eyebrow}</p>
  </div>

  <div class="video-player">
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${video.id}?rel=0&modestbranding=1`}
      title={video.title}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen
    ></iframe>
  </div>

  {publishedDate && (
    <p class="video-meta-line">
      Published {publishedDate}
      &middot; <a href={video.url} target="_blank" rel="noopener">Watch on YouTube</a>
      {playlistUrl && (
        <> &middot; <a href={playlistUrl} target="_blank" rel="noopener">Full playlist ↗</a></>
      )}
    </p>
  )}

  {video.description && (
    <>
      <h2>About this video</h2>
      <div class="video-description">{video.description}</div>
    </>
  )}

  <nav class="video-nav" aria-label="Tutorial navigation">
    {prev ? (
      <a href={`/tutorials/${prev.slug}/`} class="prev">
        <div class="nav-label">← {isSeries ? 'Previous episode' : 'Previous'}</div>
        <div class="nav-title">{prev.title}</div>
      </a>
    ) : (
      <div class="placeholder"></div>
    )}

    {next ? (
      <a href={`/tutorials/${next.slug}/`} class="next">
        <div class="nav-label">{isSeries ? 'Next episode' : 'Next'} →</div>
        <div class="nav-title">{next.title}</div>
      </a>
    ) : (
      <div class="placeholder"></div>
    )}
  </nav>

  <p style="margin-top: 2rem; text-align: center;">
    <a href={`/tutorials/#${playlist?.slug ?? ''}`}>← Back to {playlist?.title ?? 'all tutorials'}</a>
  </p>
</StarlightPage>
